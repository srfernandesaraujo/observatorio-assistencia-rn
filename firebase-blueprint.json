{
  "entities": {
    "user_settings": {
      "title": "User Settings",
      "description": "Application settings and configurations saved per user.",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "maxLength": 128
        },
        "horusUrl": {
          "type": "string",
          "maxLength": 256
        },
        "horusEnabled": {
          "type": "boolean"
        },
        "pgeUrl": {
          "type": "string",
          "maxLength": 256
        },
        "pgeEnabled": {
          "type": "boolean"
        },
        "unicatUrl": {
          "type": "string",
          "maxLength": 256
        },
        "unicatEnabled": {
          "type": "boolean"
        },
        "suvisaUrl": {
          "type": "string",
          "maxLength": 256
        },
        "suvisaEnabled": {
          "type": "boolean"
        },
        "syncFrequency": {
          "type": "string",
          "enum": [
            "realtime",
            "hourly",
            "daily",
            "weekly"
          ]
        }
      },
      "required": [
        "uid"
      ]
    }
  },
  "firestore": {
    "/settings/{userId}": {
      "schema": "user_settings",
      "description": "Collection of configurations stored on a per-user basis"
    }
  }
}

rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // 1. Global Safety Net (Default Deny)
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // Validation for Settings
    function isValidUserSettings(data) {
      return data.uid == request.auth.uid
        && (data.horusUrl == null || (data.horusUrl is string && data.horusUrl.size() <= 256))
        && (data.horusEnabled == null || data.horusEnabled is bool)
        && (data.pgeUrl == null || (data.pgeUrl is string && data.pgeUrl.size() <= 256))
        && (data.pgeEnabled == null || data.pgeEnabled is bool)
        && (data.unicatUrl == null || (data.unicatUrl is string && data.unicatUrl.size() <= 256))
        && (data.unicatEnabled == null || data.unicatEnabled is bool)
        && (data.suvisaUrl == null || (data.suvisaUrl is string && data.suvisaUrl.size() <= 256))
        && (data.suvisaEnabled == null || data.suvisaEnabled is bool)
        && (data.syncFrequency == null || data.syncFrequency in ['realtime', 'hourly', 'daily', 'weekly']);
    }

    // Settings paths
    match /settings/{userId} {
      allow get: if isOwner(userId);
      allow create: if isOwner(userId) && isValidUserSettings(incoming());
      allow update: if isOwner(userId) && isValidUserSettings(incoming()) && incoming().uid == existing().uid;
      allow delete: if false;
    }
  }
}

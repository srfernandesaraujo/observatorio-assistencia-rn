rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Padrão: negar tudo.
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null && request.auth.token.email_verified == true;
    }

    function emailLower() {
      return request.auth.token.email.lower();
    }

    // Super administração: conta fixa, a única que cadastra usuários.
    // Para transferir o observatório a outra instituição, troque este e-mail.
    function isSuper() {
      return isSignedIn() && emailLower() == 'srfernandesaraujo@gmail.com';
    }

    function perfil() {
      return get(/databases/$(database)/documents/users/$(emailLower())).data;
    }

    // Permissão para publicar um conjunto de dados (a permissão tem o mesmo id do conjunto).
    function podePublicar(datasetId) {
      return isSuper()
        || (isSignedIn()
            && exists(/databases/$(database)/documents/users/$(emailLower()))
            && perfil().ativo == true
            && perfil().permissoes.get(datasetId, false) == true);
    }

    // Cadastro de usuários: só a super administração escreve e lista;
    // cada pessoa lê apenas o próprio cadastro.
    match /users/{email} {
      allow get: if isSuper() || (isSignedIn() && emailLower() == email);
      allow list: if isSuper();
      allow create, update: if isSuper()
        && email == email.lower()
        && request.resource.data.keys().hasOnly(['email', 'nome', 'papel', 'permissoes', 'ativo', 'criadoEm', 'criadoPor'])
        && request.resource.data.email == email
        && request.resource.data.nome is string
        && request.resource.data.nome.size() > 0
        && request.resource.data.nome.size() <= 120
        && request.resource.data.papel in ['admin', 'professor', 'estudante']
        && request.resource.data.ativo is bool
        && request.resource.data.permissoes is map
        && request.resource.data.permissoes.keys().hasOnly(['desabastecimento', 'alertas_sanitarios', 'indicadores_municipais', 'municipios_regioes', 'repositorio_documentos', 'pregoes', 'custos', 'judicializacao', 'producao_cientifica']);
      allow delete: if isSuper();
    }

    // Conjuntos de dados públicos: leitura aberta, publicação conforme a permissão.
    match /datasets/{datasetId} {
      allow read: if true;
      allow create, update: if podePublicar(datasetId)
        && request.resource.data.publicadoPor == emailLower()
        && request.resource.data.fonte is string
        && request.resource.data.fonte.size() > 0
        && request.resource.data.fonte.size() <= 300
        && request.resource.data.versao is int
        && request.resource.data.totalLinhas is int
        && request.resource.data.totalLinhas <= 5000;
      allow delete: if false;

      match /chunks/{chunkId} {
        allow read: if true;
        allow create, update: if podePublicar(datasetId) && request.resource.data.linhas.size() <= 400;
        allow delete: if podePublicar(datasetId);
      }
    }
  }
}

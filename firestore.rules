rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Padrão: negar tudo.
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    // Administradores são os e-mails (em minúsculas) cadastrados em /admins/{email}.
    // O cadastro é feito pela coordenação (console/Admin SDK); o cliente não escreve em /admins.
    function isAdmin() {
      return isSignedIn()
        && request.auth.token.email_verified == true
        && exists(/databases/$(database)/documents/admins/$(request.auth.token.email.lower()));
    }

    // Cada pessoa só consegue ler o próprio cadastro (usado para saber se é administradora).
    match /admins/{email} {
      allow get: if isSignedIn() && request.auth.token.email.lower() == email;
      allow list, write: if false;
    }

    // Conjuntos de dados públicos: leitura aberta, publicação só por administradores.
    match /datasets/{datasetId} {
      allow read: if true;
      allow create, update: if isAdmin()
        && request.resource.data.publicadoPor == request.auth.token.email.lower()
        && request.resource.data.fonte is string
        && request.resource.data.fonte.size() > 0
        && request.resource.data.fonte.size() <= 300
        && request.resource.data.versao is int
        && request.resource.data.totalLinhas is int
        && request.resource.data.totalLinhas <= 5000;
      allow delete: if false;

      match /chunks/{chunkId} {
        allow read: if true;
        allow create, update: if isAdmin() && request.resource.data.linhas.size() <= 400;
        allow delete: if isAdmin();
      }
    }
  }
}
